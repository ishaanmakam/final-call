# Copy to .env (or .env.local) and fill in from Supabase dashboard > Project Settings > API.
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time; the anon key is safe to ship
# because row-level security protects every table.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: EAS project id (from `npx eas-cli@latest init`). Needed for Expo push tokens.
EAS_PROJECT_ID=
