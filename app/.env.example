# Copy to .env (or .env.local) and fill in from Supabase dashboard > Project Settings > API.
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time; the anon key is safe to ship
# because row-level security protects every table.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: EAS project id (from `npx eas-cli@latest init`). Needed for Expo push tokens.
EAS_PROJECT_ID=

# Optional: crash reporting. Off unless the DSN is set (never on in demo mode or on the web).
# Location keys are stripped from every event and breadcrumb (src/lib/sentryScrub.ts).
EXPO_PUBLIC_SENTRY_DSN=
# Defaults to development under Metro, production in a release build.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time only (EAS secrets, not EXPO_PUBLIC_): with all three set, app.config.ts adds the Sentry
# config plugin, which uploads source maps so stack traces are readable.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
